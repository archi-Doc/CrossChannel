<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <IncludeSymbols>false</IncludeSymbols>
    <IsRoslynComponent>true</IsRoslynComponent>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CrossChannelGenerator</PackageId>
    <Authors>archi-Doc</Authors>
    <Product>CrossChannelGenerator</Product>
    <Description>Source generator for CrossChannel</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/archi-Doc/CrossChannel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/archi-Doc/CrossChannel</RepositoryUrl>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\stylecop.json" Link="stylecop.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep the compiler of the oldest supported SDK (.NET 10.0.1xx = Roslyn 5.0): an older compiler skips a generator built against a newer one (CS9057). Analyzers 5.0.0 does not exist. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="4.14.0" PrivateAssets="all" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Generated\*" />
    <!-- Keep the shared source archive, but omit helpers unused by this generator. -->
    <Compile Remove="Arc.Visceral/FarmHash.Slim.cs;Arc.Visceral/VisceralDefaultValue.cs;Arc.Visceral/VisceralIdentifier.cs;Arc.Visceral/VisceralSample.cs;Arc.Visceral/VisceralTrie*.cs;Internal/ByteArrayComparer.cs" />
  </ItemGroup>

</Project>
